# =============================================
# PLANTILLA DE VARIABLES DE ENTORNO (equivale al .env.example de API-BASE-LH)
# run_dev.py la copia como .env si falta. NUNCA subas el archivo .env al repositorio
# =============================================

# Modo debug (True en desarrollo, False en producción)
DEBUG=True
# desarrollo | produccion
ENTORNO=desarrollo

# Puerto del servidor de desarrollo (el frontend local apunta a http://localhost:8080)
DEV_PORT=8080

# --- CORS: orígenes permitidos, separados por coma ---
ORIGENES_PERMITIDOS=http://localhost:5173

# --- Base de datos ---
# sqlite = demo local en privado/demo.db (crear con: python -m scripts.crear_demo)
# mysql = Cloud SQL vía Cloud SQL Auth Proxy (base de prueba en GCP, luego lahornilla_base_normalizada)
DB_MOTOR=sqlite
DB_HOST=127.0.0.1
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=certificaciones

# --- Conexión Cloud SQL (solo para Google Cloud Run, viene de Secret Manager) ---
# DATABASE_URL=mysql+pymysql://usuario:contraseña@/nombre_db?unix_socket=/cloudsql/proyecto:region:instancia

# --- Autenticación ---
# demo = selector de usuario en pantalla (solo desarrollo) | jwt = usuario o correo + clave (como LH Inventario)
AUTH_MODO=demo
# Id de Certificaciones en general_dim_app (lo crea el equipo del portal web)
APP_ID=16
# Solo AUTH_MODO=jwt. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- Archivos ---
# local = disco en privado/archivos (demo) | gcs = Cloud Storage con URLs firmadas
ALMACENAMIENTO=local
BUCKET_DOCUMENTOS=
GCP_PROJECT_ID=
# URL con la que el navegador llega a esta API (para las URLs firmadas locales)
URL_PUBLICA_API=http://localhost:8080
# Solo ALMACENAMIENTO=local. Generar con: python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_FIRMA_LOCAL=

# --- Avisos de vencimiento (días antes) ---
DIAS_ALERTA=60,30,7

# Demo publicada (Cloud Run): clave de acceso que pide la pantalla de ingreso. Vacía = demo local sin clave.
DEMO_CLAVE=
# Demo publicada: carpeta (bucket montado) con la base y los archivos de partida
SEMILLA_DIR=
